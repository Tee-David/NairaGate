{
  "name": "nairagate",
  "version": "0.1.0",
  "description": "Secure TypeScript toolkit for Nigerian bank discovery and account verification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": ["nigeria", "bank", "verification", "paystack", "typescript", "fintech"],
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
