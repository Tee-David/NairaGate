{
  "name": "nairagate",
  "version": "0.1.0",
  "description": "Secure TypeScript toolkit for Nigerian bank discovery and account verification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "nairagate-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills/nairagate/SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:prod",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "nigeria",
    "bank",
    "verification",
    "paystack",
    "typescript",
    "fintech",
    "mcp",
    "agent-skill"
  ],
  "author": "Taiwo David Dayomola",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tee-David/NairaGate.git"
  },
  "homepage": "https://github.com/Tee-David/NairaGate#readme",
  "bugs": {
    "url": "https://github.com/Tee-David/NairaGate/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
