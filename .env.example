# Server-side only. Never expose these values to browser code.
# Set only the credential(s) for the provider you configure NairaGate with.
PAYSTACK_SECRET_KEY=sk_test_replace_me
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_me
KORAPAY_SECRET_KEY=sk_test_replace_me
SQUAD_SECRET_KEY=sandbox_sk_replace_me
MONNIFY_API_KEY=MK_TEST_replace_me
MONNIFY_SECRET_KEY=replace_me

# Selects which provider `nairagate-mcp` starts with:
# "paystack" (default), "flutterwave", "korapay", "squad", or "monnify".
NAIRAGATE_PROVIDER=paystack
